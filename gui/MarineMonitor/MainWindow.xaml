<Window x:Class="MarineMonitor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MarineMonitor"
 Title="Marine Inspect · 설비 관제" Width="1440" Height="1000" MinWidth="1120" MinHeight="760" Background="#0C1422" WindowStartupLocation="CenterScreen">
 <Grid x:Name="Root" Background="#0C1422">
  <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111D2E" BorderBrush="#223148" BorderThickness="0,0,1,0">
   <DockPanel Margin="22,30,18,22">
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="M / I" FontFamily="Segoe UI" FontSize="30" FontWeight="Bold" Foreground="#46D9C1"/>
     <TextBlock Text="MARINE INSPECT" FontSize="11" FontWeight="Bold" Margin="0,10,0,0"/>
     <TextBlock Text="시뮬레이션 관제" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,42"/>
     <Border Background="#213B46" CornerRadius="6" Padding="12"><TextBlock Text="◉  설비 모니터링" Foreground="#62E2CF" FontWeight="Bold"/></Border>
     <TextBlock Text="로봇 임무" Foreground="{StaticResource Muted}" Margin="12,24,0,5"/>
     <TextBlock Text="미연결 · 추후 제공" FontSize="11" Foreground="#637A96" Margin="12,0,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
     <TextBlock Text="PROTOTYPE  /  03" FontFamily="Segoe UI" FontSize="10" Foreground="#46D9C1"/>
     <TextBlock Text="WPF + TCP JSON v1" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
     <TextBlock Text="LOCALHOST ONLY" FontSize="10" Foreground="#637A96" Margin="0,6,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="28,24,22,24">
    <Grid Margin="0,0,0,20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="설비 모니터링" FontSize="27" FontWeight="Bold"/><TextBlock Text="{Binding PreviewNotice}" Foreground="{StaticResource Muted}" Margin="0,7,0,0" FontSize="12"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="127.0.0.1 :" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,8,0"/>
      <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditPort}" Width="65" MaxLength="5" Margin="0,0,10,0" AutomationProperties.Name="TCP 포트"/>
      <Button Content="{Binding ConnectLabel}" Command="{Binding Connect}" Background="#35CBB1" Foreground="#09211E" FontWeight="Bold" Padding="18,10"/>
     </StackPanel>
    </Grid>
    <Border Background="#142236" BorderBrush="#273C54" BorderThickness="1" CornerRadius="8" Padding="18,13" Margin="0,0,6,18">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><TextBlock Text="●" Foreground="{Binding ConnectionColor}" Margin="0,0,10,0"/><TextBlock Text="{Binding Status}" FontWeight="Bold"/></StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding ReceiveInfo}" Foreground="{StaticResource Muted}" FontSize="12"/>
      <TextBlock Grid.Column="2" Text="{Binding FrameInfo}" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="12"/>
     </Grid>
    </Border>
    <ItemsControl ItemsSource="{Binding Equipment}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="#142236" BorderBrush="#27384F" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,12,0">
       <StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="{Binding Title}" FontSize="23" FontWeight="Bold"/><TextBlock Text="{Binding Source}" Foreground="{StaticResource Muted}" Margin="0,4,0,0" FontFamily="Consolas"/></StackPanel>
         <Border Grid.Column="1" Background="#253A4F" CornerRadius="5" Padding="10,6" VerticalAlignment="Top"><TextBlock Text="{Binding State}" FontSize="11" Foreground="#B5D1E9"/></Border>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,15,0,17">
         <TextBlock Text="시뮬레이션 설정  " Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Simulation}" FontSize="11" FontWeight="Bold"/>
         <TextBlock Text="     진단  " Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Diagnosis}" FontSize="11" Foreground="#E9B15C"/>
        </StackPanel>
        <Border Height="1" Background="#2A3A50" Margin="0,0,0,14"/>
        <Grid><TextBlock Text="전류 · 3채널" FontWeight="Bold"/><TextBlock HorizontalAlignment="Right" FontSize="10"><Run Text="CH1   " Foreground="#38D8C3"/><Run Text="CH2   " Foreground="#6BA4FF"/><Run Text="CH3" Foreground="#E9B15C"/></TextBlock></Grid>
        <TextBlock Text="{Binding CurrentValues}" FontFamily="Consolas" FontSize="21" Foreground="#5DE0CA" Margin="0,8,0,4"/>
        <TextBlock Text="{Binding CurrentRms}" FontSize="11" Foreground="{StaticResource Muted}"/>
        <local:TrendChart Series="{Binding CurrentTrend}" Height="105" Margin="0,8,0,12"/>
        <TextBlock Text="진동 · 1채널" FontWeight="Bold"/>
        <Grid Margin="0,7,0,0"><TextBlock Text="{Binding VibrationValue}" FontFamily="Consolas" FontSize="23" Foreground="#5DE0CA"/><TextBlock Text="{Binding VibrationRms}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}"/></Grid>
        <local:TrendChart Series="{Binding VibrationTrend}" Height="100" Margin="0,5,0,10"/>
        <TextBlock Text="{Binding FileInfo}" FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="17"/>
        <TextBlock Text="{Binding Error}" Foreground="#FF9E96" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
        <TextBlock Text="재생 테스트 제어" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,8"/>
        <WrapPanel>
         <Button Content="일시정지" Command="{Binding Control}" CommandParameter="pause" FontSize="11" Padding="10,8"/>
         <Button Content="재개" Command="{Binding Control}" CommandParameter="resume" FontSize="11" Padding="10,8"/>
         <Button Content="재시작" Command="{Binding Control}" CommandParameter="restart" FontSize="11" Padding="10,8"/>
         <Button Content="정지" Command="{Binding Control}" CommandParameter="stop" FontSize="11" Padding="10,8"/>
         <Button Content="정상" Command="{Binding Control}" CommandParameter="normal" FontSize="11" Padding="10,8"/>
         <Button Content="고장" Command="{Binding Control}" CommandParameter="fault" FontSize="11" Padding="10,8"/>
        </WrapPanel>
        <TextBlock Text="{Binding LastCommand}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,9,0,0"/>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="최근 60초의 수신 추세 · 약 10Hz 표시값이며 원본 파형 분석용이 아닙니다. RMS는 파일 전체 구간 값입니다. 단위 미지정." Foreground="{StaticResource Muted}" FontSize="10" Margin="1,12,0,18" TextWrapping="Wrap"/>
    <Border Background="#142236" BorderBrush="#27384F" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,6,0">
     <StackPanel><Grid><TextBlock Text="이벤트 이력" FontWeight="Bold" FontSize="15"/><TextBlock Text="최근 150건 · 세션 내 기록" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="10"/></Grid>
      <ListBox ItemsSource="{Binding Events}" Height="115" Background="Transparent" BorderThickness="0" Margin="0,8,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0,4"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}" FontFamily="Consolas" FontSize="11" Foreground="#6584A7"/><TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
