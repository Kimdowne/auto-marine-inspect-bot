    m_Url: 
    m_AutoStart: 1
    m_Loop: 1
  m_WindowTitle:
    m_Untranslated: Industry Fundamentals
  m_Title:
    m_Untranslated: 'Bringing CAD to Life: From Import to Interaction '
  m_Description:
    m_Untranslated: "In this In-Editor Tutorial, you\u2019ll learn how to bring CAD
      models into Unity and transform them into interactive, optimized digital assets.\n\nUsing
      the <b>Unity Asset Transformer Toolkit</b>, you\u2019ll import and configure
      CAD data, analyze and optimize geometry for performance, automate repetitive
      processing with rulesets, and build an interactive application.\n\nBy the end,
      you\u2019ll connect UI controls to your model \u2014 turning a static CAD object
      into a responsive, scene-integrated robot ready for simulation, visualization,
      or prototyping.\n\n<b>Recommended platform:</b> Windows\n<b>Note:</b> The <b>Asset
      Transformer Toolkit</b> requires a Unity Industry License. \n\nIf you don\u2019t
      have a Unity Industry license yet, you can activate a 30-day free trial.\nFollow
      <a href=\"https://service-store.unity.com/en/order/create?product=UTY-INDUSTRY-TRIAL&variant=unity-industry-30-day-trial\">the
      link</a> and the instructions on the page to get started."
  m_MaskEditor: 1
  m_Buttons:
  - Text:
      m_Untranslated: Close
