  m_Name: 
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "CAD models \u2014 especially those that are heavily optimized
      \u2014 may have broken or inconsistent normals. These cause shading artifacts
      and lighting issues."
