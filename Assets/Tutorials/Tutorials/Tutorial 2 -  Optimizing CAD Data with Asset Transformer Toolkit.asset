  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Aggressive decimation can sometimes introduce new geometry issues
      like holes. These appear as missing faces, especially when viewing from certain
      angles. \n\nThis step involves utilizing the available debug tools to locate
      and then correct the issues introduced during the previous decimation process."
