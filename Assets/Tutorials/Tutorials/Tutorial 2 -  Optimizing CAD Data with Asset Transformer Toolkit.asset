--- !u!114 &3694675756167808423
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: '1.  In the <b>Hierarchy</b>, select the affected GameObject.


      2.
      In the <b>Unity Asset Transform Toolkit</b> toolbar, select <b>Create Normals
      (Smoothness)</b>.


      3. Set the <b>Smoothing Angle</b> to 60.


      4.
      Select <b>Run</b> to apply the changes.'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
--- !u!114 &4561112215229303860
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: Z-fighting occurs when two mesh surfaces occupy the same space,
      causing flickering or rendering artifacts. The <b>Unity Asset Transform Toolkit</b>
      provides tools to remove overlapping geometry that causes these issues.
--- !u!114 &5006203713693825725
