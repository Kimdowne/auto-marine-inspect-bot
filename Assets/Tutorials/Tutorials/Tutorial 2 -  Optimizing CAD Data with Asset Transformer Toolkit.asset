--- !u!114 &-4298840457442495346
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "1. In the <b>Debug</b>  dropdown, select <b>Show Back-faces</b>
      . This will allow you to quickly spot the holes as backfaces will be visible
      through them.\n\n2. Inspect the suckers of the robot \u2014 blue areas indicate
      missing geometry.\n\n3. In the <b>Hierarchy</b> , shift-select all suckers
      of the robot.\n\n4. From the <b>UATT</b> toolbar, select <b>Remove Holes</b>
      .\n\n5. Leave the settings as they are and select <b>Run</b> ."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
