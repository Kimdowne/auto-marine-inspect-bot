  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "To enhance the realism and personality of your robot, you can
      add visual details like stickers, warning signs, or logos. These are applied
      as <b>decals</b>\u2014flat images on transparent planes that overlay the surface
      of your model without altering its geometry.\nIn this step, you\u2019ll add
      a set of premade decals to the robot using a provided prefab.\n"
