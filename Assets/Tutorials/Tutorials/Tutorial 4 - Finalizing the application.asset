--- !u!114 &3452240442840284952
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "With your robot fully configured and connected to the user interface,
      it\u2019s time to test it in Play mode. When the scene runs, the robot should
      be automatically registered with the Dashboard UI, allowing you to view its
      data and follow it with the camera.\n\n<b>Note:</b> We recommend expanding
      the Game window for a better view of the application menus.\n\n"
--- !u!114 &3797890493361399074
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: '1. In the <b>Dashboard</b>, select the <b>Manual</b> button.
      You can now use the <b>WASD</b> keys to drive the robot manually around the
      scene.


      2. Locate the <b>Speed</b> property and set its value to <b>10</b>.
      Use the <b>WASD</b> keys again to confirm the robot now moves faster.


      3.
      Select the <b>Auto</b> button in the UI. The control sliders become locked,
      indicating the robot is no longer manually controlled. The robot begins automatically
      navigating between warehouse waypoints using pathfinding.


      4. Stop the
      <b>Play mode</b>.'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
