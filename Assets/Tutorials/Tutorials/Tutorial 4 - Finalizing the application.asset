--- !u!114 &631230657397992608
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "1. In the <b>Hierarchy window</b>, select the <b>Moto</b> GameObject.\n\n2.
      In the <b>Inspector window</b>, confirm that a <b>Robot Variant</b> component
      has been added.\n\n3. Expand the <b>Variants</b> section of the Robot Variant
      component.\n\n4. Select the <b>Add (+)</b> button to create a new variant.\n\n5.
      In the <b>Hierarchy</b>, expand your <b>Moto Gameobject</b> to <b>Moto</b>
      > <b>moto.SLDASM</b> > <b>moto</b> > <b>Default</b> > <b>level_02-1</b> > <b>level_03-1</b>.\n\n6.
      Drag this <b>level_03-1</b> GameObject into the <b>Object to Enable</b> slot.\n\n7.
      Copy the same <b>level_03-1</b> GameObject and paste it into the <b>Part That
      Moves</b> field.\n\n8. Set <b>Movement Axis</b> to <b>Z</b>.\n\n9. Set <b>Starting
      Value</b> to <b>\u20133</b>.\n\n10. Set <b>Ending Value</b> to <b>\u20132.5</b>.\n\n11.
      Repeat steps 4\u201310 using the <b>level_03_variant_01-1</b> GameObject instead."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
