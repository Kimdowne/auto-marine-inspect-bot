--- !u!114 &-4592439337752858390
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "1. In <b>Assets</b> > <b>3DModels</b>, locate the newly imported
      <b>Moto Prefab</b> again and drag it into the <b>Hierarchy</b>. \n\n2. Reset
      the <b>Transform</b> again in the <b>Inspector window</b> to centre the prefab
      in the scene.\n\n3. In the <b>Hierarchy window</b>, select the <b>Moto</b>
      GameObject</b>.\n\n4. In the <b>Inspector window</b>, select <b>Add Component</b>.\n\n5.
      Search for and add the <b>Robot</b> component.\n\n6. Select the <b>padlock
      icon</b> at the top of the inspector window to keep the Robot information visible.\n\n7.
      In the <b>Project</b> window, navigate to <b>Assets > Warehouse > RobotData</b>.\n\n8.Right-click
      in the folder and select <b>Create > Industry Template > Robot Data</b>. A
      new ScriptableObject is created that stores robot-specific information.\n\n9.
      Drag the newly created <b>Robot Data</b> asset onto the <b>Data</b> field of
      the <b>Robot</b> component on the <b>Moto</b> GameObject. You\u2019ll notice
      that new components are automatically added for you. These are all components
      that are necessary to link the robot to the scene.\n"
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
