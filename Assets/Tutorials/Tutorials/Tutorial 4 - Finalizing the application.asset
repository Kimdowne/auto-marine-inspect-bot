--- !u!114 &-3105987511881996556
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "This tutorial focuses on preparing the robot model for use in
      Unity. Creating a full user interface and control system is outside the scope
      of this tutorial,so we provide a prebuilt script to handle runtime setup. This
      script automatically adds the necessary components and links the robot to the
      user interface when the application runs.\n\nIn this step, you\u2019ll add
      the Robot component to your robot GameObject and create a Robot Data ScriptableObject
      that holds configuration details."
