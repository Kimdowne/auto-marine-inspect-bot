  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: '1. In the <b>Project</b> window, navigate to <b>Assets > Warehouse
      > Prefabs</b>.


      2. Find the <b>decalCage</b> prefab and drag it onto
      the <b>Moto</b> GameObject in the <b>Hierarchy window</b>. This adds all included
      decals as children of the robot.


      3. The decal cage should appear in
      the correct location by default.If necessary, use the <b>Move Tool</b> to reposition
      it for better alignment.'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
