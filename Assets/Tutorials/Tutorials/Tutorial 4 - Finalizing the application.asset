    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Once your robot is running in the scene, you can interact with
      it through the Dashboard. The dashboard allows you to switch visual variants,
      monitor the robot\u2019s status, and test changes to data values in real time
      using the linked Robot Data ScriptableObject."
--- !u!114 &-7222715496212860828
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
