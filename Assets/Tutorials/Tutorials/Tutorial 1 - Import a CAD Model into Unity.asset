--- !u!114 &-8999108370967053234
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "1. In <b>Assets</b> > <b>3DModels</b>, locate the newly imported
      <b>Moto Prefab</b>. This is the one with the blue cube icon.\n\n2. Drag the
      Prefab into the <b>Hierarchy window</b> to add it to your scene.\n\n3. Select
      the <b>Three dot (\u22EE) menu</b> on the right side of the Transform component
      in the Inspector.\n\n4. Select <b>Reset</b>. This will move the model to the
      world centre.\n\n<b>Explore imported metadata</b>\n\n5. Select and expand the
      prefab in the <b>Hierarchy</b>\n\n6. Select one of the child objects that make
      up this model and  look at the <b>Inspector</b>.\n\n7. You\u2019ll see metadata
      fields such as <b>names</b>, <b>IDs</b>, and <b>properties</b> attached to
      the model."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
