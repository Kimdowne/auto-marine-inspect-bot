--- !u!114 &7027292460917466033
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "1. Open the Package Manager by going to <b>Window</b> > <b>Package
      Management</b> > <b>Package Manager</b>.\n\n<b>Note:</b> The <b>Asset Transformer
      Toolkit</b> requires an Industry License and the package will not be available
      without it. \n\n2. In the top-left dropdown, switch the <b>Packages location</b>
      to <b>Unity Registry</b>. \n\n3. Search for <b>Asset Transformer Toolkit</b>.\n\n4.
      Select the package and select <b>Install</b>.\n\n5. Wait for Unity to finish
      installing the package and its dependencies.\n\n6. Close the <b>Package Manager</b>
      window. \n\n7. Look for a new <b>Asset Transformer</b> menu or toolbar in the
      Unity Editor. \n\n<b>Note</b>: If the toolbar is not visible, select the <b>Three
      dot (\u22EE) menu</b> at the top right of the <b>Scene window</b>, then select
      <b>Overlays > Overlay menu</b>. On this menu, make sure everything under <b>Custom</b>
      > <b>Asset Transformer Toolbox</b>   is active."
  m_CriteriaCompletion: 1
  m_Criteria:
    m_Items:
    - Type:
        m_TypeName: Unity.Tutorials.Editor.PackageInstalledCriterion, Unity.Tutorials.Editor,
          Version=0.0.0.0, Culture=neutral, PublicKeyToken=null
      Criterion: {fileID: -3233564692430639827}
