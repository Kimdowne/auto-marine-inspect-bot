      Set that targets and removes holes from the model."
--- !u!114 &-8840259482012387039
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: '1. In the <b>Project</b> window, right-click the <b>Assets</b>
      folder and select<b>Create > Folder</b>.

      2. Name the folder <b>RuleSets</b>.

      3.
      In the <b>Project window, navigate to <b>Assets > RuleSets</b> and open the
      folder.

      4. Inside the RuleSets folder, right-click and select <b>Create
      > Asset Transformer > Rule Set</b>.

      5. Name the new asset <b>Replace
      Material</b>.

'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
