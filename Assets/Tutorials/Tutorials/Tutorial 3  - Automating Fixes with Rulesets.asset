--- !u!114 &-2429785446141813156
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "You\u2019ve now set up a <b>fully automated import process</b>
      for your CAD model. Each time the model is reimported, your <b>transformation
      rules, cleanup operations</b>, and <b>material assignments</b> will be applied
      automatically \u2014 ensuring a consistent and efficient workflow.\n\nNext,
      it\u2019s time to view your model in its <b>simulation environment</b>. In
      the next tutorial, you\u2019ll explore the environment we\u2019ve prepared
      to see your imported model in action.\n\n\nSelect <b>Done</b> to move to the
      next tutorials.\n\n<b>Note:</b> You don\u2019t have to save the scene."
