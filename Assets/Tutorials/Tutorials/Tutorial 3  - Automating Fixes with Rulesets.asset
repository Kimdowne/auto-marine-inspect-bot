--- !u!114 &-9196379457078230590
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "So far, you\u2019ve created rules that handle individual or
      grouped tasks. But the <b>Unity Asset Transformer Toolkit (UATT)</b> also supports
      complex Rule Sets that apply multiple actions in sequence. This allows you
      to build powerful workflows that automatically clean up and optimize imported
      models during the import process.\nIn this step, you\u2019ll begin creating
      a comprehensive rule that simplifies the model\u2019s hierarchy as part of
      a larger cleanup routine.\n"
