    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "By chaining these actions together, you\u2019ve now created
      a master Rule Set that calls other specialized rules. This improves maintainability
      and allows each Rule Set to be tested or reused independently."
