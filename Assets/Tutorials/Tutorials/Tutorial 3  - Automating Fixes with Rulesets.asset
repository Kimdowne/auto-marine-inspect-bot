    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "You\u2019ve now created a multi-step AO baking workflow that
      processes both the entire model and its key moving parts individually. This
      ensures high visual fidelity while keeping animated components clean and free
      of baked-in shading issues."
