  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "1. In theRule Set Editor, locate the first rule in the list.\n\n2.
      Select the <b>Three dot (\u22EE) menu</b> next to the rule\u2019s name and
      select Rename</b>.\n\n3. Enter <b>Simplify Hierarchy</b> as the new name.\n\n4.
      Select <b>Add Rule</b> below the first rule.\n\n5. In the newly created rule,
      open the <b>Three dot (\u22EE) menu</b> and select Rename</b>.\n\n6. Name this
      rule <b>Fix Z Fighting</b>.\n\n7. With <b>Fix Z Fighting</b> rule selected,
      select <b>Add Action</b>.\n\n8. Search for and select <b>Remove Z-Fighting</b>
      from the action list.\n"
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
