--- !u!114 &-6589169604027503977
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "You can structure a Rule Set to perform multiple operations
      in sequence, each with its own filter or scope. In this case it is useful when
      baking Ambient Occlusion (AO), especially if certain parts of the model\u2014like
      moving components\u2014require separate handling.\nIn this step, you\u2019ll
      create a multi-step Rule Set that bakes AO on the entire model and then rebakes
      selected parts independently using filters.\n"
