  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: 'Once your <b>Import Rule</b> Rule Set is complete, you can apply
      it directly to your CAD asset so it runs every time the model is imported.
      This ensures all cleanup, optimization, and material replacement steps happen
      automatically.

      In this step, you''ll assign the Rule Set to the CAD
      model and configure mesh settings before reimporting.'
