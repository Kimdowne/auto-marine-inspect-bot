--- !u!114 &-5135270759237683932
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "1. In the <b>Import Rules</b> Rule Set, select <b>Add Rule</b>.\n\n2.
      A new rule will appear below the previous ones.\n\n3. Open the <b>Three dot
      (\u22EE) menu</b> next to the new rule\u2019s name and select <b>Rename</b>.\n\n4.
      Name the rule <b>Remove Holes</b>.\n\n5. With the <b>Remove Holes</b> rule
      selected, choose <b>Add Action</b>.\n\n6. Search for and Select Filter on Metadata.
      This will allow you to isolate specific parts of the model.\n\n7. Under the 
      <b>Property Filter</b> section, set the  <b>Filter String</b> to <b>SW-File
      Name(File Name)</b>.\n\n8. Under the  <b>Value Filter</b> section, set the 
      <b>Filter String</b> to <b>glider_support_assm</b>.\n\n9. Select <b>Add Action</b>.\n\n10.
      Search for and select <b>Remove Holes</b> from the action list.\n\n11. Unity
      uses meters by default and you want to make sure only the small openings are
      removed. Change the <b>Max Diameter</b> to 0.01. This will ensure only openings
      smaller than 10mm will be removed.\n"
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
--- !u!114 &-5128042462413987484
