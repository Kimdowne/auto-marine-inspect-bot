  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: '1. In the <b>RuleSets</b> folder, right-click and select <b>Create
      > Asset Transformer > Rule Set</b>.


      2. Name the new asset <b>Import
      Rules</b>.


      3. Open the three dots menu next to the rule name and select
      <b>Rename</b>.


      4. Name the rule <b>Rule 1</b>.


      5. In theRule
      Set Editor, select <b>Add Action</b>.


      6. Select <b>Hierarchy > Merge</b>.


      7.
      In the new action, set the <b>Type</b> property to <b>MergeFinal Level</b>.'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
