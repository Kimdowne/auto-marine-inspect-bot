  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "1. Select <b>Add Rule</b> to create a new step.\n\n2.  In the
      rule, select <b>Add Action</b>.\n\n3. Search for and select <b>Filter on Name</b>.\n\n4.
      Set the <b>Filter String</b> to <b>level_03_variant_01-1</b>.\n\n5. Enable
      <b>Include Subhierarchy</b> to select all child objects of the filtered object.\n\n6
      .Select <b>Add Action</b> again.\n\n7. Search for and select <b>Bake Ambient
      Occlusion</b>.\n\n8. Set <b>Storage Method</b> to <b>Vertex Color</b>.\n\n9.
      Set <b>Samples</b> to <b>16</b>.\n\n10. Set <b>Denoiser</b> to <b>Low</b>.\n\n11.
      Expand the <b>Advanced section</b> and activate the <b>Singularize Instances</b>
      option.\n\n12. Rename the rule to <b>Bake Variant 1</b>\n\n<b>Duplicate and
      adjust the rule for another variant.</b>\n\n13. Open the <b>three dots (\u22EE)
      menu</b> next to <b>Bake Variant 1</b> and select <b>Duplicate</b>.\n\n14.
      In the duplicated rule, change the <b>Filter String</b> to <b>level_03-1</b>.\n\n15.
      Rename the rule to <b>Bake Variant 2</b>.\n\n16. <b>Run</b> the rule. This
      may take a while to complete.\n\n17. To see the <b>Ambient Occlusion</b> baked
      into the vertices, go to the <b>Debug dropdown menu</b> and select <b>Vertex
      Colors</b>. "
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
