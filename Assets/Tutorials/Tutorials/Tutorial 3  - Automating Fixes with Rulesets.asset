--- !u!114 &2354583905482959690
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "1. In the <b>Import Rules</b> Rule Set, select <b>Add Rule</b>.\n\n2.
      A new rule appears at the bottom of the list.\n\n3. Open the <b>Three dot (\u22EE)
      menu</b> next to the new rule\u2019s name and select <b>Rename</b>.\n\n4. Name
      the rule <b>Create Smooth Normals</b>.\n\n5. With <b>Create Smooth Normals</b>
      selected, choose <b>Add Action</b>.\n\n6. Search for and select <b>Create Normals
      (Smoothness)</b>. \n\n7. Set the <b>Smoothing angle</b> to <b>60</b>.\n"
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
--- !u!114 &2513232043458177280
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: '1. In the <b>Project</b> window, go to   <b>Assets</b> > <b>RuleSets</b>. 
      This folder has been created for you. In your own projects, you can create
      and organise folders as needed, using any naming convention that suits your
      workflow.


      2. Inside the RuleSets folder, right-click and select <b>Create
      > Asset Transformer > Rule Set</b>.


      3. Name the new asset <b>Replace
      Material</b>.'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
--- !u!114 &3182855491302552181
