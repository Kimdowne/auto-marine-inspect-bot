  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "This rule will automatically smooth out the shading across your
      model's surfaces, improving visual quality without modifying the geometry.
      In the next step, you\u2019ll review and run the complete Rule Set."
